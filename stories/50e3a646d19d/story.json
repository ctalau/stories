  "storyName": "Viaţă",
  "folder": "stories/50e3a646d19d",
  "storyTitleAudioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/50e3a646d19d/audio/title.mp3",
  "chunks": [
    {
      "page": 0,
      "text": "Viaţă",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/50e3a646d19d/images/page-1.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/50e3a646d19d/audio/page-1.mp3"
    },
    {
      "page": 1,
      "text": "Şi a pus Adam femeii sale numele Eva, adică viaţă.",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/50e3a646d19d/images/page-2.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/50e3a646d19d/audio/page-2.mp3"
    },
    {
      "page": 2,
      "text": "Ea era să fie mama tuturor celor vii.",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/50e3a646d19d/images/page-3.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/50e3a646d19d/audio/page-3.mp3"
    },
    {
      "page": 3,
      "text": "Domnul Dumnezeu a făcut lui Adam şi femeii lui îmbrăcăminte de piele şi i-a îmbrăcat.",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/50e3a646d19d/images/page-4.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/50e3a646d19d/audio/page-4.mp3"
    },
    {
      "page": 4,
      "text": "Adam s-a făcut ca unul dintre Noi, cunoscând binele şi răul.",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/50e3a646d19d/images/page-5.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/50e3a646d19d/audio/page-5.mp3"
    },
    {
      "page": 5,
      "text": "Şi acum nu cumva să-şi întindă mâna şi să ia roade din pomul vieţii, să mănânce şi să trăiască în veci.",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/50e3a646d19d/images/page-6.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/50e3a646d19d/audio/page-6.mp3"
    },
    {
      "page": 6,
      "text": "De aceea l-a scos Domnul Dumnezeu din grădina cea din Eden, ca să lucreze pământul.",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/50e3a646d19d/images/page-7.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/50e3a646d19d/audio/page-7.mp3"
    },
    {
      "page": 7,
      "text": "Şi a pus heruvimi şi sabie de flacără vâlvâitoare să păzească drumul către pomul vieţii.",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/50e3a646d19d/images/page-8.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/50e3a646d19d/audio/page-8.mp3"
    },
    {
      "page": 8,
      "text": "După aceea a cunoscut Adam pe Eva, femeia sa, şi ea a născut pe Cain.",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/50e3a646d19d/images/page-9.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/50e3a646d19d/audio/page-9.mp3"
    },
    {
      "page": 9,
      "text": "Apoi a mai născut pe Abel, fratele lui Cain.",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/50e3a646d19d/images/page-10.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/50e3a646d19d/audio/page-10.mp3"
    },
    {
      "page": 10,
      "text": "Abel a fost păstor de oi, iar Cain lucrător de pământ.",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/50e3a646d19d/images/page-11.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/50e3a646d19d/audio/page-11.mp3"
    }
  ],
  "createdAt": "2026-04-15T07:38:23.511Z"
}