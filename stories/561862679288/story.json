{
  "storyId": "561862679288",
  "shareUrl": "https://gemini.google.com/share/561862679288",
  "storyName": "Avram şi Lot",
  "folder": "stories/561862679288",
  "storyTitleAudioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/561862679288/audio/title.mp3",
  "chunks": [
    {
      "page": 0,
      "text": "Avram şi Lot",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/561862679288/images/page-1.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/561862679288/audio/page-1.mp3"
    },
    {
      "page": 1,
      "text": "Avram s-a suit din Egipt. Lot era împreună cu el.",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/561862679288/images/page-2.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/561862679288/audio/page-2.mp3"
    },
    {
      "page": 2,
      "text": "Avram era foarte bogat în vite, în argint şi în aur.",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/561862679288/images/page-3.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/561862679288/audio/page-3.mp3"
    },
    {
      "page": 3,
      "text": "Lot avea şi el oi, boi şi corturi.",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/561862679288/images/page-4.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/561862679288/audio/page-4.mp3"
    },
    {
      "page": 4,
      "text": "Pământul nu-i mai încăpea să locuiască împreună. S-a iscat o certă între păzitorii vitelor.",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/561862679288/images/page-5.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/561862679288/audio/page-5.mp3"
    },
    {
      "page": 5,
      "text": "Avram a zis lui Lot: „Să nu fie certă între mine şi tine, căci suntem fraţi.”",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/561862679288/images/page-6.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/561862679288/audio/page-6.mp3"
    },
    {
      "page": 6,
      "text": "„Desparte-te de mine: dacă apuci tu la stânga, eu voi apuca la dreapta.”",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/561862679288/images/page-7.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/561862679288/audio/page-7.mp3"
    },
    {
      "page": 7,
      "text": "Lot şi-a ridicat ochii şi a văzut toată câmpia Iordanului. Era bine udată peste tot.",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/561862679288/images/page-8.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/561862679288/audio/page-8.mp3"
    },
    {
      "page": 8,
      "text": "Lot şi-a ales toată câmpia Iordanului. S-au despărţit unul de altul.",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/561862679288/images/page-9.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/561862679288/audio/page-9.mp3"
    },
    {
      "page": 9,
      "text": "Avram a locuit în ţara Canaan.",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/561862679288/images/page-10.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/561862679288/audio/page-10.mp3"
    },
    {
      "page": 10,
      "text": "Domnul a zis lui Avram: „Tot pământul pe care-l vezi, ţi-l voi da ţie pe vecie.”",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/561862679288/images/page-11.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/561862679288/audio/page-11.mp3"
    },
    {
      "page": 11,
      "text": "„Voi face sămânţa ta ca pulberea pământului.” Avram şi-a ridicat corturile.",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/561862679288/images/page-12.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/561862679288/audio/page-12.mp3"
    },
    {
      "page": 12,
      "text": "Avram a locuit lângă stejarul lui Mamre. Acolo a zidit un altar Domnului.",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/561862679288/images/page-13.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/561862679288/audio/page-13.mp3"
    }
  ],
  "createdAt": "2026-04-15T09:39:02.024Z"
}