  "storyTitleAudioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/e1b98c458c7a/audio/title.mp3",
  "chunks": [
    {
      "page": 0,
      "text": "Ziua a Șasea: Facerea Lumii",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/e1b98c458c7a/images/page-1.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/e1b98c458c7a/audio/page-1.mp3"
    },
    {
      "page": 1,
      "text": "„Apoi Dumnezeu a zis: „Să dea pământul vieţuitoare după soiul lor: vite, târâtoare şi fiare pământeşti, după soiul lor.” Şi aşa a fost.”",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/e1b98c458c7a/images/page-2.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/e1b98c458c7a/audio/page-2.mp3"
    },
    {
      "page": 2,
      "text": "„Dumnezeu a făcut fiarele pământului după soiul lor, vitele după soiul lor şi toate târâtoarele pământului după soiul lor. Dumnezeu a văzut că erau bune.”",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/e1b98c458c7a/images/page-3.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/e1b98c458c7a/audio/page-3.mp3"
    },
    {
      "page": 3,
      "text": "„Apoi Dumnezeu a zis: „Să facem om după chipul Nostru, după asemănarea Noastră;”",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/e1b98c458c7a/images/page-4.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/e1b98c458c7a/audio/page-4.mp3"
    },
    {
      "page": 4,
      "text": "„el să stăpânească peste peştii mării, peste păsările cerului, peste vite, peste tot pământul şi peste toate târâtoarele care se mişcă pe pământ.”",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/e1b98c458c7a/images/page-5.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/e1b98c458c7a/audio/page-5.mp3"
    },
    {
      "page": 5,
      "text": "„Dumnezeu a făcut pe om după chipul Său, l-a făcut după chipul lui Dumnezeu; parte bărbătească şi parte femeiască i-a făcut.”",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/e1b98c458c7a/images/page-6.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/e1b98c458c7a/audio/page-6.mp3"
    },
    {
      "page": 6,
      "text": "„Dumnezeu i-a binecuvântat şi Dumnezeu le-a zis: „Fiţi roditori, înmulţiţi-vă, umpleţi pământul şi supuneţi-l;”",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/e1b98c458c7a/images/page-7.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/e1b98c458c7a/audio/page-7.mp3"
    },
    {
      "page": 7,
      "text": "„şi stăpâniţi peste peştii mării, peste păsările cerului şi peste orice vieţuitoare care se mişcă pe pământ.”",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/e1b98c458c7a/images/page-8.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/e1b98c458c7a/audio/page-8.mp3"
    },
    {
      "page": 8,
      "text": "„Şi Dumnezeu a zis: „Iată că v-am dat orice iarbă care face sămânţă şi care este pe faţa întregului pământ şi orice pom care are în el rod cu sămânţă: aceasta să fie hrana voastră.”",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/e1b98c458c7a/images/page-9.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/e1b98c458c7a/audio/page-9.mp3"
    },
    {
      "page": 9,
      "text": "„Iar tuturor fiarelor pământului, tuturor păsărilor cerului şi tuturor târâtoarelor care se mişcă pe pământ, care au în ele suflare de viaţă, le-am dat ca hrană toată iarba verde.” Şi aşa a fost.”",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/e1b98c458c7a/images/page-10.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/e1b98c458c7a/audio/page-10.mp3"
    },
    {
      "page": 10,
      "text": "„Dumnezeu S-a uitat la tot ce făcuse; şi iată că erau foarte bune. Astfel, a fost o seară şi apoi a fost o dimineaţă: aceasta a fost ziua a şasea.”",
      "imageUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/e1b98c458c7a/images/page-11.png",
      "audioUrl": "https://raw.githubusercontent.com/ctalau/stories/main/stories/e1b98c458c7a/audio/page-11.mp3"
    }
  ],
  "createdAt": "2026-04-14T19:38:14.125Z"
}